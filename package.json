{
  "name": "nanobrowser",
  "version": "0.2.1",
  "description": "AI web automation tool",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nanobrowser/nanobrowser.git"
  },
  "type": "module",
  "scripts": {
    "postinstall": "node src/i18n/generate-i18n.mjs && wxt prepare",
    "prepare": "husky",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "pnpm build && tsx scripts/zip.ts",
    "test": "vitest run",
    "type-check": "node src/i18n/generate-i18n.mjs && wxt prepare && tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --fix --cache --cache-location node_modules/.cache/.eslintcache",
    "prettier": "prettier . --write --cache --cache-location node_modules/.cache/.prettiercache",
    "clean": "rimraf dist dist-zip .wxt",
    "clean:node_modules": "pnpx rimraf node_modules",
    "clean:install": "pnpm clean:node_modules && pnpm install --frozen-lockfile",
    "update-version": "bash update_version.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@ai-sdk/azure": "4.0.89",
    "@ai-sdk/deepseek": "3.0.58",
    "@ai-sdk/google": "4.0.87",
    "@ai-sdk/openai": "4.0.83",
    "@ai-sdk/xai": "5.0.14",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.126",
    "clsx": "^2.1.1",
    "jsonrepair": "^3.15.0",
    "posthog-js": "^1.434.17",
    "puppeteer-core": "^25.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^2.4.0",
    "webextension-polyfill": "^0.12.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.19.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "deepmerge": "^4.3.1",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "fast-glob": "^3.3.2",
    "fflate": "^0.8.3",
    "husky": "^9.1.4",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "5.0.2",
    "wxt": "0.21.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": "^10.34.6",
    "npm": "please-use-pnpm"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild"
    ]
  }
}
